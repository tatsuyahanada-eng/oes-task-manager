# DB Controller (PHP 版)
#
# すべてのリクエストを index.php へ集める。
# 静的ファイルも index.php が配るので、ログインしていない人には渡らない。

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 実在するファイルでも、index.php を通す（ログイン確認のため）
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# 万一 mod_rewrite が効かない環境でも、大事なものは直接読ませない
<FilesMatch "\.(json|log|masterkey)$">
    Require all denied
</FilesMatch>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(json|log|masterkey)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ディレクトリの中身を一覧させない
Options -Indexes
