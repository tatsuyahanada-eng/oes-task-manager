# DB Controller (PHP 版)
#
# すべてのリクエストを index.php へ集めます。
# 静的ファイルも index.php が配るので、ログインしていない人には渡りません。
#
# ─────────────────────────────────────────────
# HTTP 500 が出る場合、まずこのファイルの名前を
# .htaccess-off などに変えて、原因の切り分けをしてください。
# 名前を変えても画面は出ます（ログイン確認は index.php 側でも働きます）。
# ─────────────────────────────────────────────

DirectoryIndex index.php

# DUMP や大きな CSV を受け取れるようにします。
# 効かないサーバでは無視されるだけなので、そのままで構いません。
# （効かない場合は、同じ内容を .user.ini に書くか、契約先の管理画面で設定してください）
<IfModule mod_php.c>
    php_value post_max_size 128M
    php_value upload_max_filesize 128M
</IfModule>
<IfModule mod_php7.c>
    php_value post_max_size 128M
    php_value upload_max_filesize 128M
</IfModule>
<IfModule mod_php8.c>
    php_value post_max_size 128M
    php_value upload_max_filesize 128M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # RewriteBase は書きません。
    # 書くと、サブディレクトリに置いたときサイトの一番上へ飛ばそうとして
    # 404 になります。省略すれば、この .htaccess のある場所が基準になります。

    # 自己診断だけは、本体を通さずそのまま実行させる。
    # ここを通してしまうと、本体が壊れているときに
    # 診断ページ自体が「見つかりません」になって届かない。
    RewriteRule ^check\.php$ - [L]

    # 実在するファイルでも index.php を通す（ログイン確認のため）
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# 万一 mod_rewrite が効かない環境でも、大事なものは直接読ませない。
#
# Apache 2.4 と 2.2 で書き方が違います。
# 囲まずに書くと、対応していない側で 500 エラーになります。
<IfModule mod_authz_core.c>
    <FilesMatch "\.(json|log|masterkey)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(json|log|masterkey)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ディレクトリ一覧を止めたい場合は、次の行の # を外してください。
# サーバによっては Options の指定が許可されておらず、
# 500 エラーの原因になるため、既定では無効にしています。
# Options -Indexes
